{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "0.3.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/badblli/pacc",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://pokemon-auto-chess.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "tr_redirect",
        "enabled": true,
        "path": "rules/tr_redirect.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://pokemon-auto-chess.com/*"
      ],
      "js": [
        "page/game-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pokemon-auto-chess.com/*"
      ],
      "js": [
        "content/i18n.js",
        "content/advisor.js",
        "content/overlay.js",
        "content/panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "locales/tr/translation.json",
        "i18n/en.json",
        "i18n/tr.json",
        "i18n/game.en.json",
        "data/static.json",
        "content/panel.css",
        "content/overlay.css",
        "icons/icon-48.png"
      ],
      "matches": [
        "https://pokemon-auto-chess.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "__MSG_cmdTogglePanel__"
    }
  }
}
